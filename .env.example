# Copia este archivo como .env y ajusta los valores.
# Con DEBUG=True y sin DATABASE_URL el proyecto usa SQLite (db.sqlite3).

DEBUG=True
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes de confianza para CSRF en producción (https://tu-dominio)
CSRF_TRUSTED_ORIGINS=

# Opcional: MySQL o PostgreSQL
# DATABASE_URL=mysql://usuario:contraseña@localhost:3306/sistemahorario
# DATABASE_URL=postgres://usuario:contraseña@localhost:5432/sistemahorario
